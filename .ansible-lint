---
profile: production

exclude_paths:
  - .cache/
  - .github/
  - group_vars/  # contains vault-encrypted files that cannot be parsed

skip_list:
  # Roles are grouped into subdirectories (roles/security/<name>, roles/filesystems/
  # <name>) and referenced by path from run.yml.
  - role-name[path]
  # Shared configuration (docker_dir, mergerfs_root, username, ...) lives in
  # group_vars/all/vars.yml and is consumed by many roles by design.
  - var-naming[no-role-prefix]
  # These roles are internal to this playbook and are never published to Galaxy.
  - meta-no-info
  - meta-runtime
  # Role directories are named after the upstream project, hyphens and all
  # (hd-idle, container-fleet, snapraid-backup).
  - role-name

# Third-party roles installed via requirements.yml are not ours to lint.
mock_roles:
  - bertvv.samba
  - geerlingguy.security
  - geerlingguy.ntp
  - chriswayg.msmtp-mailer
  - stuvusit.smartd
  - oefenweb.dns
  - notthebee.ubuntu_autoinstall
  - ironicbadger.snapraid
